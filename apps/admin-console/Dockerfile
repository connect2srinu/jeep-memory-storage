FROM node:22-alpine AS build
WORKDIR /application
ARG VITE_CONTROL_PLANE_API_URL=/control-plane-api/api/v1/admin
ENV VITE_CONTROL_PLANE_API_URL=$VITE_CONTROL_PLANE_API_URL
ARG VITE_ENTRA_AUTH_ENABLED=false
ARG VITE_ENTRA_TENANT_ID
ARG VITE_ENTRA_SPA_CLIENT_ID
ARG VITE_ENTRA_API_SCOPE
ARG VITE_ENTRA_REDIRECT_URI
ARG VITE_ENTRA_PLATFORM_ADMIN_ROLE=Platform.Admin
ARG VITE_ENTRA_PLATFORM_USER_ROLE=Platform.User
ARG VITE_LOCAL_ADMIN_USER=platform-admin@example.com
ARG VITE_LOCAL_ADMIN_ROLE=PLATFORM_ADMIN
ARG VITE_LOCAL_ADMIN_DOMAINS=grocery,customer
ENV VITE_ENTRA_AUTH_ENABLED=$VITE_ENTRA_AUTH_ENABLED \
    VITE_ENTRA_TENANT_ID=$VITE_ENTRA_TENANT_ID \
    VITE_ENTRA_SPA_CLIENT_ID=$VITE_ENTRA_SPA_CLIENT_ID \
    VITE_ENTRA_API_SCOPE=$VITE_ENTRA_API_SCOPE \
    VITE_ENTRA_REDIRECT_URI=$VITE_ENTRA_REDIRECT_URI \
    VITE_ENTRA_PLATFORM_ADMIN_ROLE=$VITE_ENTRA_PLATFORM_ADMIN_ROLE \
    VITE_ENTRA_PLATFORM_USER_ROLE=$VITE_ENTRA_PLATFORM_USER_ROLE \
    VITE_LOCAL_ADMIN_USER=$VITE_LOCAL_ADMIN_USER \
    VITE_LOCAL_ADMIN_ROLE=$VITE_LOCAL_ADMIN_ROLE \
    VITE_LOCAL_ADMIN_DOMAINS=$VITE_LOCAL_ADMIN_DOMAINS
COPY apps/admin-console/package.json apps/admin-console/package-lock.json apps/admin-console/tsconfig.json apps/admin-console/vite.config.ts ./
COPY apps/admin-console/index.html ./
COPY apps/admin-console/src ./src
RUN npm ci && npm run build

FROM nginx:1.27-alpine
COPY apps/admin-console/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /application/dist /usr/share/nginx/html
EXPOSE 80
