{
  "$defs": {
    "ContractMetadata": {
      "additionalProperties": false,
      "properties": {
        "displayName": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Displayname"
        },
        "domain": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Domain"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "owner": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContractOwner"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "version": {
          "default": "1.0",
          "title": "Version",
          "type": "string"
        }
      },
      "title": "ContractMetadata",
      "type": "object"
    },
    "ContractOwner": {
      "additionalProperties": false,
      "properties": {
        "email": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Email"
        },
        "team": {
          "title": "Team",
          "type": "string"
        }
      },
      "required": [
        "team"
      ],
      "title": "ContractOwner",
      "type": "object"
    },
    "MemoryProfileDefinition": {
      "additionalProperties": false,
      "properties": {
        "fields": {
          "items": {
            "$ref": "#/$defs/MemoryProfileField"
          },
          "title": "Fields",
          "type": "array"
        },
        "generation": {
          "$ref": "#/$defs/MemoryProfileGeneration"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9-]{0,62}$",
          "title": "Id",
          "type": "string"
        },
        "memoryType": {
          "const": "STRUCTURED_PROFILE",
          "default": "STRUCTURED_PROFILE",
          "title": "Memorytype",
          "type": "string"
        },
        "ownerDomain": {
          "title": "Ownerdomain",
          "type": "string"
        },
        "scopeKeys": {
          "items": {
            "type": "string"
          },
          "title": "Scopekeys",
          "type": "array"
        }
      },
      "required": [
        "id",
        "ownerDomain",
        "scopeKeys",
        "fields"
      ],
      "title": "MemoryProfileDefinition",
      "type": "object"
    },
    "MemoryProfileField": {
      "additionalProperties": false,
      "properties": {
        "preference": {
          "title": "Preference",
          "type": "string"
        },
        "profileField": {
          "title": "Profilefield",
          "type": "string"
        }
      },
      "required": [
        "preference",
        "profileField"
      ],
      "title": "MemoryProfileField",
      "type": "object"
    },
    "MemoryProfileGeneration": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "inferredFieldsAllowed": {
          "default": false,
          "title": "Inferredfieldsallowed",
          "type": "boolean"
        },
        "requireUserConfirmation": {
          "items": {
            "type": "string"
          },
          "title": "Requireuserconfirmation",
          "type": "array"
        },
        "sources": {
          "items": {
            "enum": [
              "CONFIRMED_PREFERENCE_CANDIDATE",
              "SESSION_EVENTS",
              "EXPLICIT_PROFILE_SYNC"
            ],
            "type": "string"
          },
          "title": "Sources",
          "type": "array"
        }
      },
      "title": "MemoryProfileGeneration",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "memory.platform/v1alpha1",
      "default": "memory.platform/v1alpha1",
      "title": "Apiversion",
      "type": "string"
    },
    "kind": {
      "const": "MemoryProfiles",
      "title": "Kind",
      "type": "string"
    },
    "metadata": {
      "$ref": "#/$defs/ContractMetadata"
    },
    "profiles": {
      "items": {
        "$ref": "#/$defs/MemoryProfileDefinition"
      },
      "title": "Profiles",
      "type": "array"
    }
  },
  "required": [
    "kind",
    "metadata"
  ],
  "title": "MemoryProfilesContract",
  "type": "object"
}
