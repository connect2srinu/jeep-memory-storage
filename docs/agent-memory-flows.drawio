      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="session-context" name="5. Session Context Override">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="Contextual Override — Preserve Owner Authority" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=24;fontStyle=1;fontColor=#17365D;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="40" as="geometry"/></mxCell>
        <mxCell id="customer" value="Customer-owned profile&#xa;customer.diet = vegetarian&#xa;LONG_TERM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="90" y="120" width="300" height="95" as="geometry"/></mxCell>
        <mxCell id="statement" value="User to Grocery agent&#xa;Today, do not apply my vegetarian preference" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="500" y="120" width="360" height="95" as="geometry"/></mxCell>
        <mxCell id="candidate" value="Grocery-owned candidate&#xa;grocery.diet_override = none&#xa;SESSION" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="970" y="120" width="320" height="95" as="geometry"/></mxCell>
        <mxCell id="auth" value="Grocery may write Grocery key&#xa;Customer key is unchanged" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="970" y="330" width="320" height="80" as="geometry"/></mxCell>
        <mxCell id="session" value="Managed Session state&#xa;STORED_IN_SESSION" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="970" y="520" width="320" height="105" as="geometry"/></mxCell>
        <mxCell id="resolve" value="Effective context contains both logical keys&#xa;customer.diet + grocery.diet_override" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="500" y="520" width="370" height="90" as="geometry"/></mxCell>
        <mxCell id="consume" value="Grocery agent applies contextual directive&#xa;Current resolver does not automatically&#xa;make diet_override replace diet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="90" y="510" width="340" height="105" as="geometry"/></mxCell>
        <mxCell id="new" value="New session" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="530" y="735" width="200" height="60" as="geometry"/></mxCell>
        <mxCell id="gone" value="grocery.diet_override absent&#xa;customer.diet remains" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="890" y="725" width="300" height="80" as="geometry"/></mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="statement" target="candidate"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="candidate" target="auth"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="auth" target="session"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="session" target="resolve"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="customer" target="resolve"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="resolve" target="consume"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="session ends" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="consume" target="new"><mxGeometry relative="1" as="geometry"/></mxCell>
