    </mxGraphModel>
  </diagram>
  <diagram id="failure-production" name="7. Failure and Production Controls">
    <mxGraphModel dx="1700" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="950" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="Failure Isolation, Security, Observability, and Production Gaps" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=24;fontStyle=1;fontColor=#17365D;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1050" height="40" as="geometry"/></mxCell>
        <mxCell id="context" value="PreferenceContextService&#xa;concurrent source reads" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="690" y="90" width="300" height="75" as="geometry"/></mxCell>
        <mxCell id="session" value="Session failure" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="100" y="260" width="220" height="65" as="geometry"/></mxCell>
        <mxCell id="profile" value="Explicit/Profile failure" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="420" y="260" width="240" height="65" as="geometry"/></mxCell>
        <mxCell id="memory" value="Memory Bank failure" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="760" y="260" width="230" height="65" as="geometry"/></mxCell>
        <mxCell id="mismatch" value="Schema-owner mismatch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1090" y="260" width="250" height="65" as="geometry"/></mxCell>
        <mxCell id="unauth" value="Unauthorized candidate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1440" y="260" width="220" height="65" as="geometry"/></mxCell>
        <mxCell id="degrade" value="Read failure → empty source + warning&#xa;Resolve remaining authorized values + defaults" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="340" y="455" width="430" height="90" as="geometry"/></mxCell>
        <mxCell id="failclosed" value="Write/admission failure → fail closed&#xa;REJECTED • NOT_PERSISTED • CROSS_DOMAIN_CANDIDATE&#xa;Never claim successful persistence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="930" y="445" width="480" height="105" as="geometry"/></mxCell>
        <mxCell id="effective" value="Effective context + warnings&#xa;Agent continues safely when policy permits" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="370" y="665" width="360" height="85" as="geometry"/></mxCell>
        <mxCell id="observe" value="Structured observability&#xa;latency • source errors • dispositions&#xa;authorization • mismatch metrics&#xa;No raw sensitive values" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="890" y="650" width="390" height="115" as="geometry"/></mxCell>
        <mxCell id="identity" value="Production identity + tenancy&#xa;Verified Agent Identity • least privilege&#xa;exact user/app/domain scope" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;dashed=1;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="815" width="390" height="95" as="geometry"/></mxCell>
        <mxCell id="durable" value="Production lifecycle services&#xa;durable candidates/audit • approval • revisioning&#xa;retention • correction • deletion • managed cache" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;dashed=1;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="600" y="805" width="500" height="110" as="geometry"/></mxCell>
        <mxCell id="slo" value="SLO and resilience validation&#xa;load • quota • cost • regional recovery&#xa;cross-domain and cross-tenant adversarial tests" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;dashed=1;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1230" y="810" width="410" height="100" as="geometry"/></mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="context" target="session"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="context" target="profile"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="context" target="memory"><mxGeometry relative="1" as="geometry"/></mxCell>
