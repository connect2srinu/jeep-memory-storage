        <mxCell id="e12" value="if release fails" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1" source="verify" target="rollback"><mxGeometry relative="1" as="geometry"/></mxCell>
