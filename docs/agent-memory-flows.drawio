        <mxCell id="schema" value="memory_profiles.json&#xa;structured schemas grouped by scope-key signature" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="700" y="105" width="320" height="85" as="geometry"/></mxCell>
        <mxCell id="manifest" value="profile_manifest.json&#xa;schema ID → declared owner + generation policy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="1090" y="105" width="320" height="85" as="geometry"/></mxCell>
        <mxCell id="deploy" value="deploy.py applies context_spec&#xa;Schema deployment does not create values" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="670" y="285" width="380" height="85" as="geometry"/></mxCell>
        <mxCell id="event" value="Authorized generation event&#xa;confirmed user/domain content" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="90" y="460" width="280" height="80" as="geometry"/></mxCell>
        <mxCell id="scope" value="Exact scope&#xa;user_id + app_name + domain" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="430" y="460" width="280" height="80" as="geometry"/></mxCell>
        <mxCell id="provider" value="Provider evaluates schemas sharing&#xa;the scope-key signature&#xa;Domain value is not a schema predicate" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="780" y="445" width="350" height="110" as="geometry"/></mxCell>
        <mxCell id="returned" value="Returned profile records&#xa;schema_id + fields + requested scope" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="1200" y="460" width="300" height="80" as="geometry"/></mxCell>
        <mxCell id="guard" value="Admission decision&#xa;manifest owner = scope domain = key owner?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="710" y="660" width="300" height="140" as="geometry"/></mxCell>
        <mxCell id="accept" value="ACCEPT&#xa;Domain-aware field mapping&#xa;Catalog validation → resolver" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="690" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="reject" value="REJECT + metric/audit&#xa;Never resolve foreign schema output&#xa;Example: customer.diet = Organic" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1120" y="690" width="360" height="90" as="geometry"/></mxCell>
        <mxCell id="isolate" value="High-isolation option&#xa;Separate Memory Bank or independently selectable scope signature" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="1110" y="835" width="380" height="75" as="geometry"/></mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="contracts" target="compiler"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="compiler" target="schema"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="compiler" target="manifest"><mxGeometry relative="1" as="geometry"/></mxCell>
