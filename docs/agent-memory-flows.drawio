  <diagram id="deployment" name="6. Deployment Lifecycle">
    <mxGraphModel dx="1700" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="950" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="DevOps — Resource Creation and Release Lifecycle" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=24;fontStyle=1;fontColor=#17365D;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="950" height="40" as="geometry"/></mxCell>
        <mxCell id="pre" value="Cloud foundation prerequisites&#xa;project • billing • APIs • region&#xa;IAM • network • audit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="110" width="300" height="100" as="geometry"/></mxCell>
        <mxCell id="pr" value="Pull request&#xa;YAML + generated artifacts + tests" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="420" y="120" width="280" height="80" as="geometry"/></mxCell>
        <mxCell id="ci" value="CI validation&#xa;validate • compile --check • pytest&#xa;No cloud changes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="770" y="110" width="300" height="100" as="geometry"/></mxCell>
        <mxCell id="approval" value="Environment approval" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1150" y="110" width="220" height="100" as="geometry"/></mxCell>
        <mxCell id="deploy" value="scripts/deploy.py&#xa;First standard cloud mutation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1430" y="120" width="240" height="80" as="geometry"/></mxCell>
        <mxCell id="bucket" value="Staging bucket&#xa;Create if absent" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="120" y="365" width="250" height="100" as="geometry"/></mxCell>
        <mxCell id="runtime" value="Agent Runtime&#xa;Create if ID empty&#xa;Update if ID configured" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="470" y="365" width="280" height="100" as="geometry"/></mxCell>
        <mxCell id="identity" value="Agent Identity&#xa;Runtime workload identity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="840" y="375" width="260" height="80" as="geometry"/></mxCell>
        <mxCell id="state" value="Sessions + Memory Bank&#xa;Configured resource IDs&#xa;One resource or explicit overrides" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1190" y="355" width="300" height="120" as="geometry"/></mxCell>
        <mxCell id="profiles" value="Memory Profile schemas&#xa;Apply context_spec when enabled" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="760" y="570" width="300" height="85" as="geometry"/></mxCell>
        <mxCell id="generate" value="Separate generation/sync job&#xa;Creates user profile values later" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1170" y="570" width="320" height="85" as="geometry"/></mxCell>
        <mxCell id="verify" value="Smoke + integration verification&#xa;ADK Web • inspect state/memory&#xa;authorization • isolation • metrics" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="650" y="755" width="360" height="100" as="geometry"/></mxCell>
        <mxCell id="rollback" value="Rollback code/config to existing runtime ID&#xa;Data correction is a separate governed workflow" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="1100" y="765" width="410" height="80" as="geometry"/></mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="pre" target="pr"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="pr" target="ci"><mxGeometry relative="1" as="geometry"/></mxCell>
