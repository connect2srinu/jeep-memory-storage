          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d_legend" value="Green = PostgreSQL (source of truth, created at SETUP).   Orange = Memory Bank (managed, used/created at RUNTIME).   Dashed cross-link = schema structure flows DB → Memory Bank at activation.   No MCP layer exists." style="text;html=1;strokeColor=none;fillColor=none;fontSize=11;align=left;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="30" y="1070" width="1440" height="30" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="dynamic" name="5 · Dynamic Memory Topic Gate">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="d5_title" value="5 · Dynamic Memory Topic Gate  —  non-canonical facts persist ONLY within approved topics (verified: runtime_service.write_dynamic_memory · vertex_memory_store.py)" style="text;html=1;strokeColor=none;fillColor=none;fontSize=16;fontStyle=1;fontColor=#174E86;align=left;" vertex="1" parent="1">
          <mxGeometry x="30" y="16" width="1240" height="30" as="geometry" />
        </mxCell>
        <mxCell id="d5_l1" value="Agent runtime  (memory-agent / reference-agent · ADK)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFBEA;strokeColor=#D6B656;verticalAlign=top;fontStyle=1;fontSize=13;fontColor=#8A6D1B;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="30" y="60" width="290" height="820" as="geometry" />
        </mxCell>
        <mxCell id="d5_l2" value="Control Plane API — Runtime plane  (/api/v1/runtime)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1ECF7;strokeColor=#9673A6;verticalAlign=top;fontStyle=1;fontSize=13;fontColor=#6A4A86;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="330" y="60" width="340" height="820" as="geometry" />
        </mxCell>
        <mxCell id="d5_l3" value="Application DB · PostgreSQL" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF5E8;strokeColor=#82B366;verticalAlign=top;fontStyle=1;fontSize=13;fontColor=#4C7A34;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="680" y="60" width="290" height="820" as="geometry" />
        </mxCell>
        <mxCell id="d5_l4" value="Memory Bank platform  (Vertex / agentplatform 2.x)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF3E6;strokeColor=#D79B00;verticalAlign=top;fontStyle=1;fontSize=13;fontColor=#A66A00;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="980" y="60" width="290" height="820" as="geometry" />
        </mxCell>
        <mxCell id="d5_ag" value="Agent decides (canonical first): a statement that maps to NO writablePreferences entry but fits an approvedTopics entry.&#xa;client.write_dynamic_memory(topic, value)&#xa;Topic must come from the snapshot&#39;s approvedTopics — the agent never invents one." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="45" y="110" width="260" height="120" as="geometry" />
        </mxCell>
        <mxCell id="d5_ag2" value="Receives { status: accepted, reference: {domain}.topic.{topic}, profileVersion }&#xa;— or 403 (disabled / topic not approved) / 400 (sensitive content)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="45" y="700" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="d5_api0" value="RuntimeMemoryService.write_dynamic_memory" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="345" y="110" width="310" height="30" as="geometry" />
        </mxCell>
        <mxCell id="d5_s2" value="2 · authenticate principal → resolve_agent()&#xa;3 · require SUBMIT_CANDIDATES + consumer scope (domain &amp; org = agent&#39;s)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="345" y="150" width="310" height="60" as="geometry" />
        </mxCell>
        <mxCell id="d5_s4" value="4 · get_dynamic_memory_policy(agent.domain)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="345" y="225" width="310" height="30" as="geometry" />
        </mxCell>
        <mxCell id="d5_s5" value="5 · GATE  (platform enforced, not the agent):&#xa;• no policy / disabled ⇒ 403&#xa;• topic ∉ policy.memory_topics ⇒ 403&#xa;• value matches sensitive pattern (phone/SSN/card/email/secret) ⇒ 400" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="345" y="270" width="310" height="95" as="geometry" />
        </mxCell>
        <mxCell id="d5_s6" value="6 · expires_at = now + retention_days (if configured)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="345" y="380" width="310" height="30" as="geometry" />
        </mxCell>
        <mxCell id="d5_s7" value="7 · store.write_dynamic_memory(scope, topic, value, confidence, expires_at)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;fontStyle=1;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="345" y="425" width="310" height="45" as="geometry" />
        </mxCell>
        <mxCell id="d5_db" value="dynamic_memory_policies  (READ):&#xa;• enabled&#xa;• memory_topics  ← authoritative approved-topic list&#xa;• confidence_threshold  (default 0.7)&#xa;• retention_policy.retention_days&#xa;&#xa;Configured in the admin console&#39;s Create Memory Setup.&#xa;No row is written on the dynamic write path." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="695" y="225" width="260" height="185" as="geometry" />
        </mxCell>
        <mxCell id="d5_mb" value="VertexMemoryBankStore.write_dynamic_memory → agentplatform SDK&#xa;&#xa;memories.create( fact = typed shared-memory-dynamic/v1&#xa;  { topic, value, confidence, version, updated_at, expires_at },&#xa;  scope = { organization_id, user_id } )&#xa;Latest-per-topic overlay (order-independent).&#xa;&#xa;⚠ Managed generation is DISABLED: ingest_events is NOT called,&#xa;so the provider cannot extract arbitrary, ungoverned memories.&#xa;Only explicit topic-gated writes are persisted." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="995" y="425" width="260" height="230" as="geometry" />
        </mxCell>
        <mxCell id="d5_resolve" value="On RESOLVE (flow 3): approved dynamic memories are retrieved (get_dynamic_memories by approved topics) and folded in as DYNAMIC_MEMORY candidates —&#xa;ranked BELOW canonical MEMORY_PROFILE via source_priority, DROPPED when confidence &lt; confidence_threshold, and expiry-filtered.&#xa;The effective snapshot returns approvedTopics alongside writablePreferences, so the agent knows both boundaries. Resolution runs entirely in the control plane." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="45" y="800" width="1210" height="70" as="geometry" />
        </mxCell>
        <mxCell id="d5_e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#555555;fontSize=10;endArrow=block;" edge="1" parent="1" source="d5_ag" target="d5_api0">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d5_e1l" value="1 · POST /api/v1/runtime/memory/dynamic  { scope, topic, value, confidence }  (Auth: X-Agent-ID dev / Bearer prod)" style="edgeLabel;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="d5_e1">
          <mxGeometry x="-0.05" relative="1" as="geometry">
            <mxPoint y="-12" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="d5_e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4C7A34;fontSize=10;endArrow=block;" edge="1" parent="1" source="d5_s4" target="d5_db">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d5_e7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#A66A00;fontSize=10;endArrow=block;" edge="1" parent="1" source="d5_s7" target="d5_mb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d5_e8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#555555;fontSize=10;endArrow=block;dashed=1;" edge="1" parent="1" source="d5_mb" target="d5_ag2">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1125" y="720" />
              <mxPoint x="175" y="720" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="d5_e8l" value="8 · response" style="edgeLabel;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="d5_e8">
          <mxGeometry x="0.4" relative="1" as="geometry">
            <mxPoint y="-10" as="offset" />
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="requestflow" name="6 · Request Flow — Classify, Write, Resolve">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="1120" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="rf_title" value="6 · Request Flow — every write passes auth → authorization → CLASSIFICATION GATE before the store; resolve ranks + surfaces (verified: runtime_service.py)" style="text;html=1;strokeColor=none;fillColor=none;fontSize=16;fontStyle=1;fontColor=#174E86;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="16" width="1240" height="30" as="geometry"/></mxCell>

        <mxCell id="rf_l1" value="Agent runtime  (memory-agent / reference-agent · ADK)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFBEA;strokeColor=#D6B656;verticalAlign=top;fontStyle=1;fontSize=13;fontColor=#8A6D1B;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="30" y="60" width="290" height="760" as="geometry"/></mxCell>
        <mxCell id="rf_l2" value="Control Plane API — Runtime plane  (/api/v1/runtime)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1ECF7;strokeColor=#9673A6;verticalAlign=top;fontStyle=1;fontSize=13;fontColor=#6A4A86;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="330" y="60" width="340" height="760" as="geometry"/></mxCell>
        <mxCell id="rf_l3" value="Application DB · PostgreSQL  (catalog + policy, READ)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF5E8;strokeColor=#82B366;verticalAlign=top;fontStyle=1;fontSize=13;fontColor=#4C7A34;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="680" y="60" width="290" height="760" as="geometry"/></mxCell>
        <mxCell id="rf_l4" value="Memory Bank platform  (Vertex / agentplatform 2.x)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF3E6;strokeColor=#D79B00;verticalAlign=top;fontStyle=1;fontSize=13;fontColor=#A66A00;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="980" y="60" width="290" height="760" as="geometry"/></mxCell>

        <mxCell id="rf_ag" value="Agent turn decides (governed order):&#xa;1) maps to writablePreferences → canonical&#xa;2) else fits approvedTopics → dynamic&#xa;3) else decline (never invents)&#xa;&#xa;PUT /preferences/{attribute}   (canonical)&#xa;POST /memory/dynamic           (dynamic)&#xa;source = user_directed | inference" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="45" y="110" width="260" height="150" as="geometry"/></mxCell>
        <mxCell id="rf_ag2" value="Receives { status, reference, profileVersion }&#xa;or 400 (restricted) / 403 (unapproved · cross-scope · sensitive+inferred)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="45" y="650" width="260" height="70" as="geometry"/></mxCell>

        <mxCell id="rf_api0" value="RuntimeMemoryService.update_preference / write_dynamic_memory" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="345" y="110" width="310" height="30" as="geometry"/></mxCell>
        <mxCell id="rf_s2" value="1 · authenticate → resolve_agent  (X-Agent-ID dev / Bearer prod)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="345" y="150" width="310" height="45" as="geometry"/></mxCell>
        <mxCell id="rf_s3" value="2 · require capability (SUBMIT_CANDIDATES) + consumer scope&#xa;(request domain &amp; org = agent&#39;s)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="345" y="205" width="310" height="55" as="geometry"/></mxCell>
        <mxCell id="rf_s4" value="3 · AUTHORIZATION (whitelist)&#xa;canonical → resolve the one writable grant for the attribute&#xa;dynamic → policy enabled &amp; topic ∈ approvedTopics&#xa;(else 400 / 403)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="345" y="270" width="310" height="75" as="geometry"/></mxCell>
        <mxCell id="rf_gate" value="4 · CLASSIFICATION GATE  (_screen_memory_write)&#xa;effective tier = max(declared tier, content scan)&#xa;• PII / weapons / discrimination ⇒ Restricted ⇒ 400&#xa;• Sensitive + inference ⇒ 403&#xa;• else allow (carry the tier)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;fontStyle=1;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="345" y="355" width="310" height="100" as="geometry"/></mxCell>
        <mxCell id="rf_s6" value="5 · scope = { organization_id (agent), user_id (request) }" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="345" y="465" width="310" height="35" as="geometry"/></mxCell>
        <mxCell id="rf_s7" value="6 · store.write_preference / write_dynamic_memory" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;fontStyle=1;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="345" y="510" width="310" height="35" as="geometry"/></mxCell>

        <mxCell id="rf_db" value="READ-ONLY on the write path:&#xa;RegisteredAgent · AgentSchemaGrant · ProfileSchema · mappings&#xa;PreferenceDefinition.sensitivity_classification  (declared tier, canonical)&#xa;dynamic_memory_policies.memory_topics  (approved topics; &quot;topic:tier&quot; ⇒ declared tier)&#xa;&#xa;No row is written on the write path." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="695" y="270" width="260" height="185" as="geometry"/></mxCell>

        <mxCell id="rf_mb" value="VertexMemoryBankStore → agentplatform SDK  memories.create&#xa;canonical → shared-memory-explicit-preference/v1&#xa;dynamic → shared-memory-dynamic/v1&#xa;  { topic, value, confidence, sensitivity, source, version }&#xa;scope = { organization_id, user_id }&#xa;&#xa;⚠ managed generation DISABLED — only explicit gated writes persist." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="995" y="510" width="260" height="185" as="geometry"/></mxCell>

        <mxCell id="rf_audit" value="7 · AUDIT (structured log, correlation-id):  memory_write { tier: canonical|dynamic, op: created|updated, sensitivity, source, version }  ·  memory_deletion { op: forget|purge } → container logs / Cloud Logging." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#B09500;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="840" width="1240" height="45" as="geometry"/></mxCell>

        <mxCell id="rf_resolve" value="RESOLVE  (agent before_agent_callback → POST /preferences/resolve):&#xa;read canonical profiles (latest-per-attribute) + approved dynamic memories (latest-per-topic, approved only) → build candidates&#xa;[ canonical: source=MEMORY_PROFILE, confidence=1.0, sensitivity=catalog tier ]   [ dynamic: source=DYNAMIC_MEMORY, confidence, sensitivity=max(stored, topic tier), memorySource ]&#xa;→ PreferenceResolver (deterministic): filter (readable · not expired · dynamic/inferred below confidence_threshold dropped) → group by key → rank (source_priority ⇒ canonical beats dynamic; strategies) → winner&#xa;→ snapshot { preferences(+sensitivity,+memorySource), writablePreferences, approvedTopics }  →  before_model_callback injects it into Gemini&#39;s context (no read tool)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="30" y="900" width="1240" height="110" as="geometry"/></mxCell>

        <mxCell id="rf_delete" value="DELETE (governance / CCPA):  POST /memory/forget  (user right-to-be-forgotten, SUBMIT_CANDIDATES) → list user memories → delete each   ·   POST /memory/purge  (operator, ADMINISTER_MEMORY) → list org memories → filter tier/attribute/topic → dryRun previews, else delete." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="1025" width="1240" height="50" as="geometry"/></mxCell>

        <mxCell id="rf_e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#555555;fontSize=10;endArrow=block;" edge="1" parent="1" source="rf_ag" target="rf_api0"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="rf_e1l" value="HTTPS (httpx)" style="edgeLabel;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="rf_e1"><mxGeometry x="-0.1" relative="1" as="geometry"><mxPoint y="-10" as="offset"/></mxGeometry></mxCell>
        <mxCell id="rf_e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4C7A34;fontSize=10;endArrow=block;" edge="1" parent="1" source="rf_s4" target="rf_db"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="rf_e7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#A66A00;fontSize=10;endArrow=block;" edge="1" parent="1" source="rf_s7" target="rf_mb"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="rf_e9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#555555;fontSize=10;endArrow=block;dashed=1;" edge="1" parent="1" source="rf_mb" target="rf_ag2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1125" y="710"/><mxPoint x="175" y="710"/></Array></mxGeometry></mxCell>
        <mxCell id="rf_e9l" value="response" style="edgeLabel;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="rf_e9"><mxGeometry x="0.4" relative="1" as="geometry"><mxPoint y="-10" as="offset"/></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
