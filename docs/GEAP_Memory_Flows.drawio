        <mxCell id="a_db" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" value="Writes (create + activate if missing):&#xa;&#xa;• Organization, Project  (if missing)&#xa;• MemoryDomain&#xa;• ScopeDefinition  {domain}:profile-scope&#xa;   keys = organization_id + user_id&#xa;• PreferenceDefinition × N  (Preference Catalog, canonical owner = domain)&#xa;• ProfileSchema + ProfileSchemaVersion (v1) + SchemaPreferenceMapping × N&#xa;   (attribute ↔ profile_field; vertex_schema_definition; generationConfig)&#xa;• RegisteredAgent  (capabilities: resolve_context / submit_candidates / inspect_provenance)&#xa;• AccessRequest(owned) → auto-APPROVED  ⇒  AgentSchemaGrant (ACTIVE)&#xa;• AccessRequest(shared) = PENDING  (NO grant until owner approves)&#xa;• ResolutionPolicy + SchemaPriority + AttributeOverride  — ONLY if &gt; 1 schema&#xa;• DynamicMemoryPolicy  — only if dynamic memory enabled&#xa;• AuditEvent  (memory_setup.activated)" vertex="1">
          <mxGeometry height="420" width="270" x="685" y="300" as="geometry" />
        </mxCell>
