        <mxCell id="r_title" value="3 · Session Load / Preference Read Flow  —  agent loads memory at session start (verified: runtime_service.resolve_preferences · preference_resolver.py)" style="text;html=1;strokeColor=none;fillColor=none;fontSize=16;fontStyle=1;fontColor=#174E86;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="16" width="1240" height="30" as="geometry"/></mxCell>

        <mxCell id="r_l1" value="Agent runtime  (ADK)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFBEA;strokeColor=#D6B656;verticalAlign=top;fontStyle=1;fontSize=13;fontColor=#8A6D1B;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="30" y="60" width="290" height="920" as="geometry"/></mxCell>
        <mxCell id="r_l2" value="Control Plane API — Runtime plane  (/api/v1/runtime)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1ECF7;strokeColor=#9673A6;verticalAlign=top;fontStyle=1;fontSize=13;fontColor=#6A4A86;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="330" y="60" width="340" height="920" as="geometry"/></mxCell>
        <mxCell id="r_l3" value="Application DB · PostgreSQL" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF5E8;strokeColor=#82B366;verticalAlign=top;fontStyle=1;fontSize=13;fontColor=#4C7A34;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="680" y="60" width="290" height="920" as="geometry"/></mxCell>
        <mxCell id="r_l4" value="Memory Bank platform  (Vertex / agentplatform 2.x)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF3E6;strokeColor=#D79B00;verticalAlign=top;fontStyle=1;fontSize=13;fontColor=#A66A00;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="980" y="60" width="290" height="920" as="geometry"/></mxCell>

        <mxCell id="r_ag" value="Agent session starts and needs memory&#xa;client.resolve_preferences(user_id, session_id,&#xa;consumer_domain, organization_id)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="45" y="110" width="260" height="75" as="geometry"/></mxCell>
        <mxCell id="r_ag2" value="12 · inject snapshot into ADK Session state;&#xa;Gemini formats/uses it.  Gemini does NOT decide&#xa;authorization, schema selection, or resolution." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="45" y="800" width="260" height="80" as="geometry"/></mxCell>

        <mxCell id="r_api0" value="RuntimeMemoryService.resolve_preferences" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="345" y="110" width="310" height="30" as="geometry"/></mxCell>
        <mxCell id="r_s2" value="2 · authenticate → resolve_agent()  (DB)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="345" y="150" width="310" height="35" as="geometry"/></mxCell>
        <mxCell id="r_s3" value="3 · require RESOLVE_CONTEXT · require consumer scope" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="345" y="195" width="310" height="35" as="geometry"/></mxCell>
        <mxCell id="r_s4" value="4 · list_schema_grants(agent) → split READABLE / WRITABLE&#xa;(READ/READ_WRITE = readable)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="345" y="240" width="310" height="55" as="geometry"/></mxCell>
        <mxCell id="r_s5" value="5 · get_resolution_config(agent, domain)&#xa;agent policy  OR  domain default (id LIKE '{domain}:%')&#xa;+ per-attribute overrides &amp; schema precedence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="345" y="305" width="310" height="70" as="geometry"/></mxCell>
        <mxCell id="r_s6" value="6 · for each READABLE grant: store.get_profiles(owner scope, schema_id)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;fontStyle=1;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="345" y="385" width="310" height="45" as="geometry"/></mxCell>
        <mxCell id="r_s8" value="8 · build candidate Preferences (source = MEMORY_PROFILE)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="345" y="565" width="310" height="35" as="geometry"/></mxCell>
        <mxCell id="r_s9" value="9 · PreferenceResolver.resolve(candidates, policies)&#xa;deterministic per logical key — strategy chain:&#xa;SOURCE_PRIORITY → DOMAIN_PRIORITY → EXPLICIT_OVER_INFERRED&#xa;→ MOST_RECENT → HIGHEST_CONFIDENCE  (min-confidence gate)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="345" y="615" width="310" height="80" as="geometry"/></mxCell>
        <mxCell id="r_s10" value="10 · compute writablePreferences (same-domain writable grants)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="345" y="705" width="310" height="35" as="geometry"/></mxCell>

        <mxCell id="r_db" value="READ-ONLY:&#xa;RegisteredAgent · AgentSchemaGrant&#xa;→ ProfileSchema → active version → mappings&#xa;ResolutionPolicy (agent or domain-default)&#xa;+ ResolutionAttributeOverride&#xa;&#xa;⚠ No PostgreSQL write on the read path." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="695" y="240" width="260" height="160" as="geometry"/></mxCell>

        <mxCell id="r_mb" value="7 · VertexMemoryBankStore.get_profiles → agentplatform SDK&#xa;&#xa;memory_banks.memories.retrieve_profiles(scope)&#xa;   → structured Memory Profiles (provider-generated, async)&#xa;memory_banks.memories.retrieve(scope)&#xa;   → explicit-preference overlays&#xa;&#xa;merged: structured profile ⊕ explicit overlays&#xa;scope = { organization_id, user_id }" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="995" y="385" width="260" height="200" as="geometry"/></mxCell>

        <mxCell id="r_note" value="Resolution runs IN the Control Plane API (in-process, deterministic) — NOT in Memory Bank.&#xa;Policy is agent-scoped with a domain-level default; it orders across multiple schemas via precedence." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="345" y="760" width="610" height="55" as="geometry"/></mxCell>

        <!-- edges -->
        <mxCell id="r_e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#555555;fontSize=10;endArrow=block;" edge="1" parent="1" source="r_ag" target="r_api0"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r_e1l" value="1 · POST /api/v1/runtime/preferences/resolve  (or /refresh)" style="edgeLabel;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="r_e1"><mxGeometry x="-0.05" relative="1" as="geometry"><mxPoint y="-10" as="offset"/></mxGeometry></mxCell>
        <mxCell id="r_e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4C7A34;fontSize=10;endArrow=block;" edge="1" parent="1" source="r_s4" target="r_db"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r_e6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#A66A00;fontSize=10;endArrow=block;" edge="1" parent="1" source="r_s6" target="r_mb"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r_e6b" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#A66A00;fontSize=10;endArrow=block;dashed=1;" edge="1" parent="1" source="r_mb" target="r_s8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1125" y="600"/><mxPoint x="700" y="600"/></Array></mxGeometry></mxCell>
        <mxCell id="r_e6bl" value="profiles" style="edgeLabel;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="r_e6b"><mxGeometry x="0.2" relative="1" as="geometry"><mxPoint y="-10" as="offset"/></mxGeometry></mxCell>
        <mxCell id="r_e11" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#555555;fontSize=10;endArrow=block;dashed=1;" edge="1" parent="1" source="r_s10" target="r_ag2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="325" y="722"/></Array></mxGeometry></mxCell>
        <mxCell id="r_e11l" value="11 · EffectivePreferenceSnapshot { preferences, snapshot_version(hash), policy_version, schema_versions, writablePreferences }" style="text;html=1;strokeColor=none;fillColor=none;fontSize=10;align=left;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="45" y="745" width="600" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="datamodel" name="4 · Memory Resource Relationships">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1120" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="d_title" value="4 · Memory Resource Relationships  —  what lives in PostgreSQL (created at SETUP) vs Memory Bank (used at RUNTIME).  Verified against persistence/models.py." style="text;html=1;strokeColor=none;fillColor=none;fontSize=16;fontStyle=1;fontColor=#174E86;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="16" width="1440" height="30" as="geometry"/></mxCell>

        <!-- PostgreSQL group -->
        <mxCell id="d_pg" value="Application DB · PostgreSQL — system of record (created / updated at SETUP)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF5E8;strokeColor=#82B366;verticalAlign=top;fontStyle=1;fontSize=13;fontColor=#4C7A34;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="30" y="60" width="960" height="1000" as="geometry"/></mxCell>

        <mxCell id="d_org" value="Organization" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="110" width="150" height="36" as="geometry"/></mxCell>
        <mxCell id="d_proj" value="Project" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="190" width="150" height="36" as="geometry"/></mxCell>
        <mxCell id="d_dom" value="MemoryDomain" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="280" width="150" height="36" as="geometry"/></mxCell>

        <mxCell id="d_scope" value="ScopeDefinition&#xa;scope_keys = organization_id + user_id" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="300" y="255" width="200" height="46" as="geometry"/></mxCell>
        <mxCell id="d_prefdef" value="PreferenceDefinition&#xa;(Preference Catalog)&#xa;canonical owner = domain" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="300" y="330" width="200" height="56" as="geometry"/></mxCell>
        <mxCell id="d_schema" value="ProfileSchema" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="110" width="200" height="36" as="geometry"/></mxCell>
        <mxCell id="d_ver" value="ProfileSchemaVersion&#xa;exactly ONE ACTIVE · binds one ScopeDefinition&#xa;holds vertex_schema_definition" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="560" y="105" width="230" height="60" as="geometry"/></mxCell>
        <mxCell id="d_map" value="SchemaPreferenceMapping&#xa;profile_field ↔ attribute_id" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="560" y="330" width="230" height="46" as="geometry"/></mxCell>

        <mxCell id="d_agent" value="RegisteredAgent&#xa;home domain (N:1)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;fontStyle=1;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="60" y="470" width="150" height="46" as="geometry"/></mxCell>
        <mxCell id="d_grant" value="AgentSchemaGrant&#xa;agent ⇄ schema · permission&#xa;NONE/READ/WRITE/READ_WRITE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="300" y="465" width="200" height="56" as="geometry"/></mxCell>
        <mxCell id="d_req" value="AccessRequest&#xa;agent → target schema&#xa;PENDING → APPROVED ⇒ grant" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="300" y="560" width="200" height="56" as="geometry"/></mxCell>

        <mxCell id="d_respol" value="ResolutionPolicy&#xa;agent policy  OR  domain default&#xa;+ SchemaPriority (orders schemas)&#xa;+ AttributeOverride" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="560" y="465" width="230" height="70" as="geometry"/></mxCell>
        <mxCell id="d_dyn" value="DynamicMemoryPolicy&#xa;per domain (optional)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="560" y="565" width="230" height="46" as="geometry"/></mxCell>
        <mxCell id="d_audit" value="AuditEvent  (admin mutations only — append-only)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="660" width="440" height="36" as="geometry"/></mxCell>

        <mxCell id="d_pgnote" value="Cardinalities (from FKs / unique constraints):&#xa;Organization 1—N Project 1—N MemoryDomain.&#xa;MemoryDomain 1—N ScopeDefinition · 1—N ProfileSchema · 1—N PreferenceDefinition   (all 1:N — the wizard makes one each by convention).&#xa;ProfileSchema 1—N ProfileSchemaVersion (one ACTIVE); a version binds ONE ScopeDefinition and maps N preferences.&#xa;RegisteredAgent N—1 MemoryDomain (home) · N—M ProfileSchema via AgentSchemaGrant.&#xa;ResolutionPolicy is AGENT-scoped with a DOMAIN-level default; it is never schema-owned." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5FBF3;strokeColor=#82B366;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="60" y="730" width="900" height="300" as="geometry"/></mxCell>

        <!-- PG edges -->
        <mxCell id="d_e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;strokeColor=#4C7A34;fontSize=10;startArrow=none;" edge="1" parent="1" source="d_org" target="d_proj"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="d_e1l" value="1—N" style="edgeLabel;html=1;fontSize=10;labelBackgroundColor=#EAF5E8;" vertex="1" connectable="0" parent="d_e1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="d_e2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;strokeColor=#4C7A34;fontSize=10;" edge="1" parent="1" source="d_proj" target="d_dom"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="d_e2l" value="1—N" style="edgeLabel;html=1;fontSize=10;labelBackgroundColor=#EAF5E8;" vertex="1" connectable="0" parent="d_e2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="d_e3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;strokeColor=#4C7A34;fontSize=10;" edge="1" parent="1" source="d_dom" target="d_scope"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="d_e4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;strokeColor=#4C7A34;fontSize=10;" edge="1" parent="1" source="d_dom" target="d_prefdef"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="d_e5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;strokeColor=#4C7A34;fontSize=10;" edge="1" parent="1" source="d_dom" target="d_schema"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="d_e6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;strokeColor=#4C7A34;fontSize=10;" edge="1" parent="1" source="d_schema" target="d_ver"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="d_e7" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;strokeColor=#4C7A34;fontSize=10;dashed=1;" edge="1" parent="1" source="d_scope" target="d_ver"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="d_e7l" value="binds" style="edgeLabel;html=1;fontSize=10;labelBackgroundColor=#EAF5E8;" vertex="1" connectable="0" parent="d_e7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="d_e8" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;strokeColor=#4C7A34;fontSize=10;" edge="1" parent="1" source="d_ver" target="d_map"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="d_e9" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;strokeColor=#4C7A34;fontSize=10;dashed=1;" edge="1" parent="1" source="d_prefdef" target="d_map"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="d_e10" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;strokeColor=#4C7A34;fontSize=10;" edge="1" parent="1" source="d_agent" target="d_grant"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="d_e11" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;strokeColor=#4C7A34;fontSize=10;dashed=1;" edge="1" parent="1" source="d_grant" target="d_schema"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="530" y="300"/></Array></mxGeometry></mxCell>
        <mxCell id="d_e11l" value="N—M" style="edgeLabel;html=1;fontSize=10;labelBackgroundColor=#EAF5E8;" vertex="1" connectable="0" parent="d_e11"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="d_e12" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;strokeColor=#4C7A34;fontSize=10;" edge="1" parent="1" source="d_agent" target="d_respol"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="135" y="440"/><mxPoint x="675" y="440"/></Array></mxGeometry></mxCell>
        <mxCell id="d_e13" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;strokeColor=#4C7A34;fontSize=10;dashed=1;" edge="1" parent="1" source="d_dom" target="d_respol"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="230" y="298"/><mxPoint x="675" y="450"/></Array></mxGeometry></mxCell>
        <mxCell id="d_e13l" value="domain default" style="edgeLabel;html=1;fontSize=10;labelBackgroundColor=#EAF5E8;" vertex="1" connectable="0" parent="d_e13"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="d_e14" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;strokeColor=#4C7A34;fontSize=10;" edge="1" parent="1" source="d_dom" target="d_dyn"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="240" y="298"/><mxPoint x="675" y="588"/></Array></mxGeometry></mxCell>

        <!-- Memory Bank group -->
        <mxCell id="d_mb" value="Memory Bank platform — managed by Vertex (used / created at RUNTIME)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E6;strokeColor=#D79B00;verticalAlign=top;fontStyle=1;fontSize=13;fontColor=#A66A00;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1020" y="60" width="450" height="1000" as="geometry"/></mxCell>

        <mxCell id="d_re" value="Reasoning Engine / Agent Engine&#xa;context_spec.memory_bank_config&#xa;.structured_memory_configs&#xa;(grouped by scope_keys → schema_configs[].memory_schema)&#xa;&#xa;⟵ applied at ACTIVATION via runtimes.update" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1045" y="110" width="400" height="130" as="geometry"/></mxCell>

        <mxCell id="d_profile" value="Memory Profile  (per-user instance)&#xa;keyed by scope { organization_id, user_id }, per schema&#xa;⟵ created LAZILY at RUNTIME on first write / generation&#xa;(structured profile generated by the provider, async)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1045" y="300" width="400" height="110" as="geometry"/></mxCell>

        <mxCell id="d_mem" value="Explicit-preference memories + event memories&#xa;typed, exact-scope; written by memories.create / ingest_events&#xa;overlaid on the structured profile at read time" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1045" y="450" width="400" height="90" as="geometry"/></mxCell>

        <mxCell id="d_mbnote" value="MemoryScope = organization_id + user_id.  Projects and domains are&#xa;authorization metadata in PostgreSQL; they are NOT Memory Bank&#xa;partition keys.  One canonical user profile per schema per organization.&#xa;&#xa;Created at SETUP: schema STRUCTURE (context_spec).&#xa;Created at RUNTIME: per-user profile INSTANCES + memories." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8EF;strokeColor=#D79B00;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1045" y="600" width="400" height="150" as="geometry"/></mxCell>

        <!-- cross-link edge PG version -> MB context spec -->
        <mxCell id="d_x1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#D79B00;fontSize=10;dashed=1;" edge="1" parent="1" source="d_ver" target="d_re"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="900" y="135"/></Array></mxGeometry></mxCell>
        <mxCell id="d_x1l" value="vertex_schema_definition&#xa;applied at ACTIVATION" style="edgeLabel;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="d_x1"><mxGeometry x="0.1" relative="1" as="geometry"><mxPoint y="-14" as="offset"/></mxGeometry></mxCell>
        <mxCell id="d_x2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;strokeColor=#D79B00;fontSize=10;dashed=1;" edge="1" parent="1" source="d_re" target="d_profile"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="d_x2l" value="defines structure of" style="edgeLabel;html=1;fontSize=10;labelBackgroundColor=#FFF3E6;" vertex="1" connectable="0" parent="d_x2"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="d_legend" value="Green = PostgreSQL (source of truth, created at SETUP).   Orange = Memory Bank (managed, used/created at RUNTIME).   Dashed cross-link = schema structure flows DB → Memory Bank at activation.   No MCP layer exists." style="text;html=1;strokeColor=none;fillColor=none;fontSize=11;align=left;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="30" y="1070" width="1440" height="30" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
