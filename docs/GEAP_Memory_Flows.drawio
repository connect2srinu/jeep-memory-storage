        </mxCell>
        <mxCell id="r_api0" value="RuntimeMemoryService.resolve_preferences" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="345" y="110" width="310" height="30" as="geometry" />
        </mxCell>
        <mxCell id="r_s2" value="2 · authenticate → resolve_agent()  (DB)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="345" y="150" width="310" height="35" as="geometry" />
        </mxCell>
        <mxCell id="r_s3" value="3 · require RESOLVE_CONTEXT · require consumer scope" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="345" y="195" width="310" height="35" as="geometry" />
        </mxCell>
        <mxCell id="r_s4" value="4 · list_schema_grants(agent) → split READABLE / WRITABLE&#xa;(READ/READ_WRITE = readable)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="345" y="240" width="310" height="55" as="geometry" />
        </mxCell>
        <mxCell id="r_s5" value="5 · get_resolution_config(agent, domain)&#xa;agent policy  OR  domain default (id LIKE &#39;{domain}:%&#39;)&#xa;+ per-attribute overrides &amp; schema precedence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="345" y="305" width="310" height="70" as="geometry" />
        </mxCell>
        <mxCell id="r_s6" value="6 · for each READABLE grant: store.get_profiles(owner scope, schema_id)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;fontStyle=1;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="345" y="385" width="310" height="45" as="geometry" />
        </mxCell>
        <mxCell id="r_s8" value="8 · build candidate Preferences (source = MEMORY_PROFILE)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="345" y="565" width="310" height="35" as="geometry" />
        </mxCell>
        <mxCell id="r_s9" value="9 · PreferenceResolver.resolve(candidates, policies)&#xa;deterministic per logical key — strategy chain:&#xa;SOURCE_PRIORITY → DOMAIN_PRIORITY → EXPLICIT_OVER_INFERRED&#xa;→ MOST_RECENT → HIGHEST_CONFIDENCE  (min-confidence gate)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="345" y="615" width="310" height="80" as="geometry" />
        </mxCell>
        <mxCell id="r_s10" value="10 · compute writablePreferences (same-domain writable grants)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="345" y="705" width="310" height="35" as="geometry" />
        </mxCell>
        <mxCell id="r_db" value="READ-ONLY:&#xa;RegisteredAgent · AgentSchemaGrant&#xa;→ ProfileSchema → active version → mappings&#xa;ResolutionPolicy (agent or domain-default)&#xa;+ ResolutionAttributeOverride&#xa;&#xa;⚠ No PostgreSQL write on the read path." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="695" y="240" width="260" height="160" as="geometry" />
        </mxCell>
        <mxCell id="r_mb" value="7 · VertexMemoryBankStore.get_profiles → agentplatform SDK&#xa;&#xa;memory_banks.memories.retrieve_profiles(scope)&#xa;   → structured Memory Profiles (provider-generated, async)&#xa;memory_banks.memories.retrieve(scope)&#xa;   → explicit-preference overlays&#xa;&#xa;merged: structured profile ⊕ explicit overlays&#xa;scope = { organization_id, user_id }" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="995" y="385" width="260" height="200" as="geometry" />
        </mxCell>
        <mxCell id="r_note" value="Resolution runs IN the Control Plane API (in-process, deterministic) — NOT in Memory Bank.&#xa;Policy is agent-scoped with a domain-level default; it orders across multiple schemas via precedence." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="345" y="760" width="610" height="55" as="geometry" />
