          <mxGeometry x="1045" y="450" width="400" height="90" as="geometry" />
        </mxCell>
        <mxCell id="d_mbnote" value="MemoryScope = organization_id + user_id.  Projects and domains are&#xa;authorization metadata in PostgreSQL; they are NOT Memory Bank&#xa;partition keys.  One canonical user profile per schema per organization.&#xa;&#xa;Created at SETUP: schema STRUCTURE (context_spec).&#xa;Created at RUNTIME: per-user profile INSTANCES + memories." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8EF;strokeColor=#D79B00;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
