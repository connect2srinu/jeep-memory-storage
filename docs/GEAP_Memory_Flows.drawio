<mxfile host="app.diagrams.net" modified="2026-08-27T00:00:00.000Z" agent="Claude" version="24.7.17" type="device" pages="4">
  <diagram id="activation" name="1 · Memory Setup / Activation">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="1180" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="a_title" value="1 · Memory Setup / Activation Flow  —  what happens on Activate Memory Setup (verified against guided_setup.py · admin plane)" style="text;html=1;strokeColor=none;fillColor=none;fontSize=16;fontStyle=1;fontColor=#174E86;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="16" width="1240" height="30" as="geometry"/></mxCell>

        <!-- lane bands -->
        <mxCell id="a_l1" value="Control Panel UI  (apps/admin-console)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF2FB;strokeColor=#6C8EBF;verticalAlign=top;fontStyle=1;fontSize=13;fontColor=#2A5A88;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="30" y="60" width="290" height="980" as="geometry"/></mxCell>
        <mxCell id="a_l2" value="Control Plane API — Admin plane  (/api/v1/admin)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1ECF7;strokeColor=#9673A6;verticalAlign=top;fontStyle=1;fontSize=13;fontColor=#6A4A86;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="330" y="60" width="330" height="980" as="geometry"/></mxCell>
        <mxCell id="a_l3" value="Application DB · PostgreSQL  (system of record)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF5E8;strokeColor=#82B366;verticalAlign=top;fontStyle=1;fontSize=13;fontColor=#4C7A34;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="670" y="60" width="300" height="980" as="geometry"/></mxCell>
        <mxCell id="a_l4" value="Memory Bank platform  (Vertex / agentplatform 2.x)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF3E6;strokeColor=#D79B00;verticalAlign=top;fontStyle=1;fontSize=13;fontColor=#A66A00;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="980" y="60" width="290" height="980" as="geometry"/></mxCell>

        <!-- UI steps -->
        <mxCell id="a_ui1" value="Admin fills the Create Memory Setup wizard&#xa;Use Case → Preferences → Scope → Memory → Agent&#xa;→ [Sharing] → [Resolution] → Review → Activate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="45" y="110" width="260" height="90" as="geometry"/></mxCell>
        <mxCell id="a_ui2" value="Admin clicks Activate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="45" y="300" width="260" height="40" as="geometry"/></mxCell>

        <!-- API steps -->
        <mxCell id="a_api0" value="GuidedMemorySetupService" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="345" y="110" width="300" height="30" as="geometry"/></mxCell>
        <mxCell id="a_api1" value="3 · re-runs preview() (non-mutating validation:&#xa;domain-prefixed attributes, cross-refs, one owned schema)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="345" y="150" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="a_api2" value="4 · activate() — one transactional DB session&#xa;creates + activates governed resources (idempotent: reuse if present)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;fontStyle=1;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="345" y="300" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="a_api5" value="5 · store.register_schema(schema, fields)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="345" y="720" width="300" height="40" as="geometry"/></mxCell>
        <mxCell id="a_api6" value="6 · IF MEMORY_BACKEND=vertex: VertexContextProvisioner.provision()&#xa;build_vertex_context_spec(session) compiles ALL active schema&#xa;versions → context_spec.memory_bank_config.structured_memory_configs&#xa;(grouped by scope_keys)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="345" y="790" width="300" height="90" as="geometry"/></mxCell>

        <!-- DB node -->
        <mxCell id="a_db" value="Writes (create + activate if missing):&#xa;&#xa;• Organization, Project  (if missing)&#xa;• MemoryDomain&#xa;• ScopeDefinition  {domain}:profile-scope&#xa;   keys = organization_id + user_id&#xa;• PreferenceDefinition × N  (Preference Catalog, canonical owner = domain)&#xa;• ProfileSchema + ProfileSchemaVersion (v1) + SchemaPreferenceMapping × N&#xa;   (attribute ↔ profile_field; vertex_schema_definition; generationConfig)&#xa;• RegisteredAgent  (capabilities: resolve_context / submit_candidates / inspect_provenance)&#xa;• AccessRequest(owned) → auto-APPROVED  ⇒  AgentSchemaGrant (ACTIVE)&#xa;• AccessRequest(shared) = PENDING  (NO grant until owner approves)&#xa;• ResolutionPolicy + SchemaPriority + AttributeOverride  — ONLY if &gt; 1 schema&#xa;• DynamicMemoryPolicy  — only if dynamic memory enabled&#xa;• AuditEvent  (memory_setup.activated)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="685" y="300" width="270" height="420" as="geometry"/></mxCell>

        <!-- Memory Bank node -->
        <mxCell id="a_mb" value="Agent Engine / Memory Bank (existing reasoningEngine)&#xa;&#xa;client.runtimes.update(&#xa;  name = projects/…/reasoningEngines/{id},&#xa;  config = { context_spec } )&#xa;&#xa;⇒ structured_memory_configs applied to the bank&#xa;   (partial update — update_mask = context_spec)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="995" y="790" width="260" height="150" as="geometry"/></mxCell>
        <mxCell id="a_mb_note" value="⚠ NO per-user Memory Profile instances are created here.&#xa;Memory Profiles are LAZY — created at RUNTIME by Memory Bank&#xa;on the first authorized write / generation.  (profiles_created = 0)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="995" y="620" width="260" height="90" as="geometry"/></mxCell>

        <!-- edges -->
        <mxCell id="a_e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#555555;fontSize=10;endArrow=block;" edge="1" parent="1" source="a_ui1" target="a_api1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a_e1l" value="1 · POST /memory-setups/preview" style="edgeLabel;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="a_e1"><mxGeometry x="-0.1" relative="1" as="geometry"><mxPoint y="-10" as="offset"/></mxGeometry></mxCell>
        <mxCell id="a_e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#555555;fontSize=10;endArrow=block;" edge="1" parent="1" source="a_ui2" target="a_api2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a_e2l" value="2 · POST /memory-setups/activate  (PLATFORM_ADMIN)" style="edgeLabel;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="a_e2"><mxGeometry x="-0.1" relative="1" as="geometry"><mxPoint y="-10" as="offset"/></mxGeometry></mxCell>
        <mxCell id="a_e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4C7A34;fontSize=10;endArrow=block;" edge="1" parent="1" source="a_api2" target="a_db"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a_e6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#A66A00;fontSize=10;endArrow=block;" edge="1" parent="1" source="a_api6" target="a_mb"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a_e7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#555555;fontSize=10;endArrow=block;dashed=1;" edge="1" parent="1" source="a_api2" target="a_ui2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="325" y="360"/></Array></mxGeometry></mxCell>
        <mxCell id="a_e7l" value="7 · 201 → status ACTIVE / ACTIVE_WITH_PENDING_ACCESS · provisioning = PROVISIONED (vertex) or REGISTERED_LOCAL (mock)" style="text;html=1;strokeColor=none;fillColor=none;fontSize=10;align=left;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="345" y="365" width="300" height="30" as="geometry"/></mxCell>

        <mxCell id="a_legend" value="Layers:  UI (blue) · Control Plane API (purple) · PostgreSQL (green) · Memory Bank (orange).   Solid = implemented today.   ⚠ note = important runtime behaviour.   No MCP layer exists in the codebase." style="text;html=1;strokeColor=none;fillColor=none;fontSize=11;align=left;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="30" y="1050" width="1240" height="30" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="write" name="2 · Agent Preference Write">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="1180" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="w_title" value="2 · Agent Preference Write Flow  —  agent saves a preference (verified: runtime_service.update_preference · vertex_memory_store.py)" style="text;html=1;strokeColor=none;fillColor=none;fontSize=16;fontStyle=1;fontColor=#174E86;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="16" width="1240" height="30" as="geometry"/></mxCell>

        <mxCell id="w_l1" value="Agent runtime  (apps/reference-agent · ADK)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFBEA;strokeColor=#D6B656;verticalAlign=top;fontStyle=1;fontSize=13;fontColor=#8A6D1B;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="30" y="60" width="290" height="900" as="geometry"/></mxCell>
        <mxCell id="w_l2" value="Control Plane API — Runtime plane  (/api/v1/runtime)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1ECF7;strokeColor=#9673A6;verticalAlign=top;fontStyle=1;fontSize=13;fontColor=#6A4A86;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="330" y="60" width="340" height="900" as="geometry"/></mxCell>
        <mxCell id="w_l3" value="Application DB · PostgreSQL" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF5E8;strokeColor=#82B366;verticalAlign=top;fontStyle=1;fontSize=13;fontColor=#4C7A34;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="680" y="60" width="290" height="900" as="geometry"/></mxCell>
        <mxCell id="w_l4" value="Memory Bank platform  (Vertex / agentplatform 2.x)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF3E6;strokeColor=#D79B00;verticalAlign=top;fontStyle=1;fontSize=13;fontColor=#A66A00;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="980" y="60" width="290" height="900" as="geometry"/></mxCell>

        <mxCell id="w_ag" value="ADK agent tool chooses a canonical attribute + value&#xa;(model does NOT send a schemaId)&#xa;reference_agent client.update_preference(attribute, value)&#xa;— or ingest_event(text, candidates)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="45" y="110" width="260" height="90" as="geometry"/></mxCell>
        <mxCell id="w_ag2" value="Receives { status: updated, reference, profile_version }" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="45" y="780" width="260" height="50" as="geometry"/></mxCell>

        <mxCell id="w_api0" value="RuntimeMemoryService.update_preference" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="345" y="110" width="310" height="30" as="geometry"/></mxCell>
        <mxCell id="w_s2" value="2 · authenticate principal → resolve_agent()&#xa;(dev: X-Agent-ID → local:{id};  prod: Google ID token → registered principal)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="345" y="150" width="310" height="60" as="geometry"/></mxCell>
        <mxCell id="w_s3" value="3 · require capability SUBMIT_CANDIDATES&#xa;4 · require consumer scope (request domain &amp; org = agent's)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="345" y="225" width="310" height="55" as="geometry"/></mxCell>
        <mxCell id="w_s5" value="5 · list_schema_grants(agent)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="345" y="295" width="310" height="35" as="geometry"/></mxCell>
        <mxCell id="w_s6" value="6 · _resolve_write_grant(): from ACTIVE, same-domain, WRITE/READ_WRITE grants&#xa;pick the ONE schema whose mappings contain the attribute&#xa;0 matches ⇒ 400 · &gt;1 match ⇒ 400 (ambiguous) · cross-domain/read-only ⇒ 403" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="345" y="345" width="310" height="80" as="geometry"/></mxCell>
        <mxCell id="w_s7" value="7 · map attribute → profile_field&#xa;memory scope = { organization_id, user_id }&#xa;(project &amp; domain are DB authz metadata, NOT Memory Bank keys)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="345" y="440" width="310" height="70" as="geometry"/></mxCell>
        <mxCell id="w_s8" value="8 · store.write_preference(scope, schema_id, profile_field, value)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;fontStyle=1;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="345" y="525" width="310" height="45" as="geometry"/></mxCell>

        <mxCell id="w_db" value="READ-ONLY on the write path:&#xa;RegisteredAgent, AgentSchemaGrant&#xa;→ ProfileSchema → active ProfileSchemaVersion&#xa;→ SchemaPreferenceMapping (field ↔ attribute)&#xa;&#xa;⚠ NO row is written to PostgreSQL when a&#xa;preference is saved. The preference lives only&#xa;in Memory Bank. (Audit is admin-plane only.)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="695" y="255" width="260" height="180" as="geometry"/></mxCell>

        <mxCell id="w_mb" value="VertexMemoryBankStore → agentplatform SDK&#xa;&#xa;a) memory_banks.memories.retrieve(scope)&#xa;   (read existing overlays, compute next version)&#xa;b) memory_banks.memories.create(&#xa;      fact = typed explicit-preference JSON,&#xa;      scope = { organization_id, user_id } )&#xa;&#xa;No field-level structured-profile update API ⇒ the explicit&#xa;preference is stored as an exact-scope memory and overlaid&#xa;on the structured profile at read time.&#xa;Memory Bank lazily creates the user's profile on first write." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="995" y="525" width="260" height="230" as="geometry"/></mxCell>

        <!-- path callout -->
        <mxCell id="w_path" value="✓ Agent → Memory Bank path (traced in code):&#xa;Agent runtime  —HTTPS (httpx)→  Control Plane runtime API  —agentplatform SDK→  Memory Bank.&#xa;NO MCP layer.  NO direct Memory Bank call from the agent&#xa;(reference-agent imports zero provider SDKs — CI-enforced test_reference_agent_has_no_memory_bank_sdk_imports)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5F0DC;strokeColor=#2E8B57;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="45" y="850" width="1210" height="80" as="geometry"/></mxCell>

        <!-- edges -->
        <mxCell id="w_e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#555555;fontSize=10;endArrow=block;" edge="1" parent="1" source="w_ag" target="w_api0"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="w_e1l" value="1 · PUT /api/v1/runtime/preferences/{attribute}  (Auth: X-Agent-ID dev / Bearer Google ID token prod)" style="edgeLabel;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="w_e1"><mxGeometry x="-0.05" relative="1" as="geometry"><mxPoint y="-12" as="offset"/></mxGeometry></mxCell>
        <mxCell id="w_e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#4C7A34;fontSize=10;endArrow=block;" edge="1" parent="1" source="w_s5" target="w_db"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="w_e8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#A66A00;fontSize=10;endArrow=block;" edge="1" parent="1" source="w_s8" target="w_mb"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="w_e9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#555555;fontSize=10;endArrow=block;dashed=1;" edge="1" parent="1" source="w_mb" target="w_ag2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1125" y="805"/><mxPoint x="175" y="805"/></Array></mxGeometry></mxCell>
        <mxCell id="w_e9l" value="9 · response" style="edgeLabel;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="w_e9"><mxGeometry x="0.4" relative="1" as="geometry"><mxPoint y="-10" as="offset"/></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="read" name="3 · Session Load / Preference Read">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="1180" math="0" shadow="0">
