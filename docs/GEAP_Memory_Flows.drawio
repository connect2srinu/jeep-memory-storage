          <mxGeometry x="345" y="110" width="310" height="30" as="geometry" />
        </mxCell>
        <mxCell id="w_s2" value="2 · authenticate principal → resolve_agent()&#xa;(dev: X-Agent-ID → local:{id};  prod: Google ID token → registered principal)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="345" y="150" width="310" height="60" as="geometry" />
        </mxCell>
        <mxCell id="w_s3" value="3 · require capability SUBMIT_CANDIDATES&#xa;4 · require consumer scope (request domain &amp; org = agent&#39;s)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="345" y="225" width="310" height="55" as="geometry" />
        </mxCell>
        <mxCell id="w_s5" value="5 · list_schema_grants(agent)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="345" y="295" width="310" height="35" as="geometry" />
        </mxCell>
        <mxCell id="w_s6" value="6 · _resolve_write_grant(): from ACTIVE, same-domain, WRITE/READ_WRITE grants&#xa;pick the ONE schema whose mappings contain the attribute&#xa;0 matches ⇒ 400 · &gt;1 match ⇒ 400 (ambiguous) · cross-domain/read-only ⇒ 403" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="345" y="345" width="310" height="80" as="geometry" />
        </mxCell>
        <mxCell id="w_s7" value="7 · map attribute → profile_field&#xa;memory scope = { organization_id, user_id }&#xa;(project &amp; domain are DB authz metadata, NOT Memory Bank keys)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="345" y="440" width="310" height="70" as="geometry" />
        </mxCell>
        <mxCell id="w_s8" value="8 · store.write_preference(scope, schema_id, profile_field, value)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;fontStyle=1;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="345" y="525" width="310" height="45" as="geometry" />
        </mxCell>
        <mxCell id="w_db" value="READ-ONLY on the write path:&#xa;RegisteredAgent, AgentSchemaGrant&#xa;→ ProfileSchema → active ProfileSchemaVersion&#xa;→ SchemaPreferenceMapping (field ↔ attribute)&#xa;&#xa;⚠ NO row is written to PostgreSQL when a&#xa;preference is saved. The preference lives only&#xa;in Memory Bank. (Audit is admin-plane only.)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="695" y="255" width="260" height="180" as="geometry" />
        </mxCell>
        <mxCell id="w_mb" value="VertexMemoryBankStore → agentplatform SDK&#xa;&#xa;a) memory_banks.memories.retrieve(scope)&#xa;   (read existing overlays, compute next version)&#xa;b) memory_banks.memories.create(&#xa;      fact = typed explicit-preference JSON,&#xa;      scope = { organization_id, user_id } )&#xa;&#xa;No field-level structured-profile update API ⇒ the explicit&#xa;preference is stored as an exact-scope memory and overlaid&#xa;on the structured profile at read time.&#xa;Memory Bank lazily creates the user&#39;s profile on first write." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="995" y="525" width="260" height="230" as="geometry" />
        </mxCell>
        <!-- path callout -->
        <mxCell id="w_path" value="✓ Agent → Memory Bank path (traced in code):&#xa;Agent runtime  —HTTPS (httpx)→  Control Plane runtime API  —agentplatform SDK→  Memory Bank.&#xa;NO MCP layer.  NO direct Memory Bank call from the agent&#xa;(reference-agent imports zero provider SDKs — CI-enforced test_reference_agent_has_no_memory_bank_sdk_imports)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5F0DC;strokeColor=#2E8B57;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="45" y="850" width="1210" height="80" as="geometry" />
        </mxCell>
        <!-- edges -->
        <mxCell id="w_e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#555555;fontSize=10;endArrow=block;" edge="1" parent="1" source="w_ag" target="w_api0">
