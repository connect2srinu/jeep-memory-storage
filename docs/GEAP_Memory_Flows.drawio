        <mxCell id="w_ag" value="ADK agent tool chooses a canonical attribute + value&#xa;(model does NOT send a schemaId)&#xa;reference_agent client.update_preference(attribute, value)&#xa;— or ingest_event(text, candidates)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
