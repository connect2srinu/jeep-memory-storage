        <mxCell id="d_title" value="4 · Memory Resource Relationships  —  what lives in PostgreSQL (created at SETUP) vs Memory Bank (used at RUNTIME).  Verified against persistence/models.py." style="text;html=1;strokeColor=none;fillColor=none;fontSize=16;fontStyle=1;fontColor=#174E86;align=left;" vertex="1" parent="1">
