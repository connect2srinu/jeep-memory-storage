        <mxCell id="r_ag2" value="12 · inject snapshot into ADK Session state;&#xa;Gemini formats/uses it.  Gemini does NOT decide&#xa;authorization, schema selection, or resolution." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
