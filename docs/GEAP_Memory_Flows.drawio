        <mxCell id="r_e1l" value="1 · POST /api/v1/runtime/preferences/resolve  (or /refresh)" style="edgeLabel;html=1;fontSize=10;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="r_e1">
