GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_GENAI_USE_ENTERPRISE=true
GEMINI_MODEL=gemini-3.5-flash
ADK_APP_NAME=grocery_shared_preferences
PREFERENCE_DOMAIN=grocery
MINIMUM_MEMORY_CONFIDENCE=0.70
ENABLE_MEMORY_PROFILES=true

# Target application boundary. Local development initially uses the mock backend and disabled
# workload authentication; deployed environments must use vertex and verified identity.
MEMORY_BACKEND=mock
MEMORY_API_URL=http://localhost:8080
# Reference Agent only: static development token takes precedence over the Google ID-token audience.
MEMORY_API_TOKEN=
MEMORY_API_AUDIENCE=
REFERENCE_AGENT_ID=grocery-agent
DATABASE_URL=postgresql+asyncpg://shared_memory:local-development-only@localhost:5432/shared_memory
AUTH_ENABLED=false
GOOGLE_ID_TOKEN_AUDIENCE=
# Production JSON map: verified email -> {"roles": [...], "domains": [...]}
ADMIN_ROLE_BINDINGS_JSON={}
ADMIN_AUTH_MODE=bearer
# IAP format: /projects/PROJECT_NUMBER/global/backendServices/BACKEND_SERVICE_ID
IAP_JWT_AUDIENCE=
# Deployment-only JSON map: registered agent ID -> workload service-account email.
AGENT_PRINCIPAL_OVERRIDES_JSON={}
INCLUDE_LEGACY_ROUTES=false
LOG_LEVEL=INFO

# Use one Agent Platform resource for all three, or separate resources.
GOOGLE_CLOUD_AGENT_ENGINE_ID=
AGENT_PLATFORM_SESSIONS_ID=
AGENT_PLATFORM_MEMORY_BANK_ID=
AGENT_PLATFORM_STAGING_BUCKET=gs://your-agent-staging-bucket

# Opt in only after ADC and cloud resources are configured.
RUN_GCP_INTEGRATION_TESTS=0
# Optional cloud contract-test schema already provisioned in the Memory Bank context spec.
GCP_TEST_PROFILE_SCHEMA_ID=grocery-preferences-v1
